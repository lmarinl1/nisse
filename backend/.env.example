DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local MongoDB (docker compose) or Atlas connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=nisse

# Vite default origin (SPA uses Token auth; CORS origins only)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend sends: Authorization: Token <key> (see POST /api/auth/login/)
